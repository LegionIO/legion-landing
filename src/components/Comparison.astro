---
import SectionHeading from './ui/SectionHeading.astro';
const rows = [
  { capability: 'Model routing', owner: 'legion-llm', href: '/docs/flows/routing/', label: 'Follow a request' },
  { capability: 'Context curation', owner: 'legion-llm', href: '/docs/flows/context/', label: 'Inspect the mechanics' },
  { capability: 'Async task execution', owner: 'legionio', href: '/docs/flows/tasks/', label: 'Follow a task' },
  { capability: 'Service integrations', owner: 'lex-* extensions', href: '/docs/ecosystem/', label: 'Browse the catalog' },
  { capability: 'Published curation results', owner: 'lex-llm-ledger data', href: '/docs/evidence/', label: 'Examine the evidence' },
  { capability: 'Experimental coordination', owner: 'legion-gaia', href: '/docs/architecture/research/', label: 'Read the boundaries' },
];
---
<section id="comparison" class="py-14 md:py-20">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading label="Where It Sits" title="Where It Sits" subtitle="A model gateway and a distributed job engine, composed through Ruby gems. Follow each capability to its implementation and evidence." />
    <div class="rounded-2xl overflow-x-auto glass-card glow-border" data-reveal>
      <table class="w-full text-left text-sm">
        <thead class="border-b border-white/10 text-lavender"><tr><th class="p-5 font-medium">Capability</th><th class="p-5 font-medium">Implementation</th><th class="p-5 font-medium">Explore</th></tr></thead>
        <tbody>{rows.map((row) => <tr class="border-b border-white/5"><th scope="row" class="p-5 font-medium text-surface-200">{row.capability}</th><td class="p-5 font-mono text-surface-400">{row.owner}</td><td class="p-5"><a class="text-lavender underline underline-offset-4" href={row.href}>{row.label} →</a></td></tr>)}</tbody>
      </table>
    </div>
  </div>
</section>
